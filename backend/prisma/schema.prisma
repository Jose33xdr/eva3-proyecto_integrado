generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ======================================================
// ENUMS - USUARIOS Y SEGURIDAD
// ======================================================

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum TokenType {
  REFRESH
  PASSWORD_RESET
  EMAIL_VERIFICATION
}

// ======================================================
// ENUMS - PRODUCTOS
// ======================================================

enum ProductType {
  MEDICINE
  MEDICAL_DEVICE
  HYGIENE
  PERSONAL_CARE
  SUPPLEMENT
  DERMOCOSMETIC
  OTHER
}

enum PrescriptionType {
  NONE
  SIMPLE
  RETAINED
}

// ======================================================
// ENUMS - COMPRAS
// ======================================================

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

// ======================================================
// ENUMS - INVENTARIO
// ======================================================

enum InventoryLocationType {
  WAREHOUSE
  DISPLAY
  REFRIGERATED
  CONTROLLED
  QUARANTINE
  OTHER
}

enum InventoryMovementType {
  PURCHASE_RECEIPT
  TRANSFER
  SALE
  CUSTOMER_RETURN
  SUPPLIER_RETURN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  EXPIRED
  DAMAGE
  DESTRUCTION
}

// ======================================================
// ENUMS - VENTAS
// ======================================================

enum SaleStatus {
  DRAFT
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CASH
  DEBIT_CARD
  CREDIT_CARD
  BANK_TRANSFER
  OTHER
}

// ======================================================
// ENUMS - CAJA
// ======================================================

enum CashSessionStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum CashMovementType {
  OPENING
  SALE
  INCOME
  EXPENSE
  REFUND
  WITHDRAWAL
  ADJUSTMENT
}

// ======================================================
// ENUMS - DOCUMENTOS TRIBUTARIOS
// ======================================================

enum TaxDocumentType {
  RECEIPT
  INVOICE
}

enum TaxDocumentStatus {
  PENDING
  ISSUED
  ACCEPTED
  REJECTED
  CANCELLED
}

// ======================================================
// ENUMS - AUDITORÍA / ALERTAS
// ======================================================

enum AuditAction {
  CREATE
  READ
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  LOGIN_FAILED
  EXPORT
  PRINT
  APPROVE
  CANCEL
  OTHER
}

enum AlertType {
  LOW_STOCK
  OUT_OF_STOCK
  EXPIRING_SOON
  EXPIRED
  OTHER
}

enum AlertStatus {
  PENDING
  READ
  RESOLVED
  DISMISSED
}

// ======================================================
// USUARIOS
// ======================================================

model User {
  id           String     @id @default(uuid()) @db.Uuid
  rut          String     @unique @db.VarChar(20)
  firstName    String     @db.VarChar(100)
  lastName     String     @db.VarChar(100)
  email        String?    @unique @db.VarChar(150)
  phone        String?    @db.VarChar(30)
  username     String     @unique @db.VarChar(80)
  passwordHash String     @db.VarChar(255)
  status       UserStatus @default(ACTIVE)

  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?

  roleId String @db.Uuid
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  purchaseOrders     PurchaseOrder[]
  purchaseReceipts   PurchaseReceipt[]
  inventoryMovements InventoryMovement[]
  sales              Sale[]         @relation("SaleSeller")
  openedCashSessions CashSession[]  @relation("CashSessionOpenedBy")
  closedCashSessions CashSession[]  @relation("CashSessionClosedBy")
  cashMovements      CashMovement[]

  securityTokens    SecurityToken[]
  auditLogs         AuditLog[]
  alertsCreated     Alert[]                @relation("AlertCreatedBy")
  alertsResolved    Alert[]                @relation("AlertResolvedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roleId])
  @@index([status])
  @@index([lastName, firstName])
  @@map("users")
}

// ======================================================
// ROLES
// ======================================================

model Role {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique @db.VarChar(50)
  name        String  @unique @db.VarChar(100)
  description String? @db.VarChar(255)

  isSystem Boolean @default(false)
  isActive Boolean @default(true)

  users       User[]
  permissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@map("roles")
}

// ======================================================
// PERMISOS
// ======================================================

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique @db.VarChar(100)
  name        String  @db.VarChar(120)
  description String? @db.VarChar(255)

  module String @db.VarChar(80)
  action String @db.VarChar(80)

  isActive Boolean @default(true)

  roles RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([module, action])
  @@index([module])
  @@index([isActive])
  @@map("permissions")
}

// ======================================================
// ROLES <-> PERMISOS
// ======================================================

model RolePermission {
  id           String @id @default(uuid()) @db.Uuid
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now())

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

// ======================================================
// TOKENS DE SEGURIDAD
// ======================================================

model SecurityToken {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  type      TokenType
  tokenHash String    @unique @db.VarChar(255)

  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([type])
  @@index([expiresAt])
  @@map("security_tokens")
}

// ======================================================
// CATEGORÍAS
// ======================================================

model Category {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique @db.VarChar(50)
  name        String  @unique @db.VarChar(120)
  description String? @db.VarChar(255)

  isActive Boolean @default(true)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@map("categories")
}

// ======================================================
// PRINCIPIOS ACTIVOS
// ======================================================

model ActiveIngredient {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique @db.VarChar(50)
  name        String  @unique @db.VarChar(150)
  description String? @db.VarChar(255)

  isActive Boolean @default(true)

  products ProductActiveIngredient[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@map("active_ingredients")
}

// ======================================================
// PRODUCTOS
// ======================================================

model Product {
  id String @id @default(uuid()) @db.Uuid

  sku     String  @unique @db.VarChar(60)
  barcode String? @unique @db.VarChar(50)

  name        String  @db.VarChar(180)
  description String? @db.Text

  productType        ProductType
  prescriptionType   PrescriptionType @default(NONE)

  isCenabast Boolean @default(false)

  concentration      String? @db.VarChar(100)
  pharmaceuticalForm String? @db.VarChar(100)
  presentation       String? @db.VarChar(150)

  purchasePrice Decimal? @db.Decimal(12, 2)
  salePrice     Decimal  @db.Decimal(12, 2)

  cenabastMaxPrice   Decimal?  @db.Decimal(12, 2)
  cenabastValidFrom  DateTime?
  cenabastValidUntil DateTime?

  minimumStock Int @default(0)

  categoryId String   @db.Uuid
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  activeIngredients    ProductActiveIngredient[]
  purchaseOrderDetails PurchaseOrderDetail[]
  batches              Batch[]
  inventoryMovements   InventoryMovement[]
  saleItems            SaleItem[]
  alerts               Alert[]

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([productType])
  @@index([prescriptionType])
  @@index([isCenabast])
  @@index([isActive])
  @@index([name])
  @@map("products")
}

// ======================================================
// PRODUCTOS <-> PRINCIPIOS ACTIVOS
// ======================================================

model ProductActiveIngredient {
  id                 String @id @default(uuid()) @db.Uuid
  productId          String @db.Uuid
  activeIngredientId String @db.Uuid

  quantity Decimal? @db.Decimal(12, 3)
  unit     String?  @db.VarChar(30)

  product          Product          @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  activeIngredient ActiveIngredient @relation(fields: [activeIngredientId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  createdAt DateTime @default(now())

  @@unique([productId, activeIngredientId])
  @@index([productId])
  @@index([activeIngredientId])
  @@map("product_active_ingredients")
}

// ======================================================
// PROVEEDORES
// ======================================================

model Supplier {
  id String @id @default(uuid()) @db.Uuid

  rut          String  @unique @db.VarChar(20)
  businessName String  @db.VarChar(180)
  tradeName    String? @db.VarChar(180)

  contactName String? @db.VarChar(150)
  email       String? @db.VarChar(150)
  phone       String? @db.VarChar(30)

  address String? @db.VarChar(255)
  commune String? @db.VarChar(100)
  region  String? @db.VarChar(100)

  isActive Boolean @default(true)

  purchaseOrders PurchaseOrder[]
  batches        Batch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessName])
  @@index([isActive])
  @@map("suppliers")
}

// ======================================================
// ÓRDENES DE COMPRA
// ======================================================

model PurchaseOrder {
  id   String @id @default(uuid()) @db.Uuid
  code String @unique @db.VarChar(50)

  supplierId String   @db.Uuid
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  createdById String @db.Uuid
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  status PurchaseOrderStatus @default(DRAFT)

  orderDate    DateTime  @default(now())
  expectedDate DateTime?

  subtotal    Decimal @default(0) @db.Decimal(14, 2)
  taxAmount   Decimal @default(0) @db.Decimal(14, 2)
  totalAmount Decimal @default(0) @db.Decimal(14, 2)

  notes String? @db.Text

  details  PurchaseOrderDetail[]
  receipts PurchaseReceipt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supplierId])
  @@index([createdById])
  @@index([status])
  @@index([orderDate])
  @@map("purchase_orders")
}

// ======================================================
// DETALLE DE ORDEN DE COMPRA
// ======================================================

model PurchaseOrderDetail {
  id String @id @default(uuid()) @db.Uuid

  purchaseOrderId String        @db.Uuid
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  quantityOrdered  Int
  quantityReceived Int @default(0)

  unitCost Decimal @db.Decimal(12, 2)
  subtotal Decimal @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([purchaseOrderId, productId])
  @@index([purchaseOrderId])
  @@index([productId])
  @@map("purchase_order_details")
}

// ======================================================
// RECEPCIONES DE COMPRA
// ======================================================

model PurchaseReceipt {
  id   String @id @default(uuid()) @db.Uuid
  code String @unique @db.VarChar(50)

  purchaseOrderId String        @db.Uuid
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  receivedById String @db.Uuid
  receivedBy   User   @relation(fields: [receivedById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  receivedAt DateTime @default(now())
  notes      String?  @db.Text

  batches Batch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([purchaseOrderId])
  @@index([receivedById])
  @@index([receivedAt])
  @@map("purchase_receipts")
}

// ======================================================
// UBICACIONES DE INVENTARIO
// ======================================================

model InventoryLocation {
  id String @id @default(uuid()) @db.Uuid

  code        String                @unique @db.VarChar(50)
  name        String                @unique @db.VarChar(120)
  type        InventoryLocationType
  description String?               @db.VarChar(255)
  isActive    Boolean               @default(true)

  stocks            InventoryStock[]
  outgoingMovements InventoryMovement[] @relation("MovementOrigin")
  incomingMovements InventoryMovement[] @relation("MovementDestination")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([isActive])
  @@map("inventory_locations")
}

// ======================================================
// LOTES
// ======================================================

model Batch {
  id          String @id @default(uuid()) @db.Uuid
  batchNumber String @db.VarChar(100)

  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  supplierId String?   @db.Uuid
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  purchaseReceiptId String?          @db.Uuid
  purchaseReceipt   PurchaseReceipt? @relation(fields: [purchaseReceiptId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  manufacturingDate DateTime?
  expirationDate    DateTime
  receivedAt        DateTime  @default(now())
  initialQuantity   Int

  purchasePrice Decimal? @db.Decimal(12, 2)

  isBlocked   Boolean @default(false)
  blockReason String? @db.VarChar(255)

  stocks            InventoryStock[]
  movements         InventoryMovement[]
  saleItemBatches   SaleItemBatch[]
  alerts            Alert[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, batchNumber])
  @@index([productId])
  @@index([supplierId])
  @@index([purchaseReceiptId])
  @@index([expirationDate])
  @@index([isBlocked])
  @@map("batches")
}

// ======================================================
// STOCK POR LOTE Y UBICACIÓN
// ======================================================

model InventoryStock {
  id String @id @default(uuid()) @db.Uuid

  batchId String @db.Uuid
  batch   Batch  @relation(fields: [batchId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  locationId String            @db.Uuid
  location   InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  quantity         Int @default(0)
  reservedQuantity Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([batchId, locationId])
  @@index([batchId])
  @@index([locationId])
  @@map("inventory_stocks")
}

// ======================================================
// MOVIMIENTOS DE INVENTARIO
// ======================================================

model InventoryMovement {
  id String @id @default(uuid()) @db.Uuid

  type InventoryMovementType

  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  batchId String @db.Uuid
  batch   Batch  @relation(fields: [batchId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  originLocationId String?            @db.Uuid
  originLocation   InventoryLocation? @relation("MovementOrigin", fields: [originLocationId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  destinationLocationId String?            @db.Uuid
  destinationLocation   InventoryLocation? @relation("MovementDestination", fields: [destinationLocationId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  quantity Int
  unitCost Decimal? @db.Decimal(12, 2)

  referenceType String? @db.VarChar(80)
  referenceId   String? @db.VarChar(100)
  reason        String? @db.VarChar(255)

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([productId])
  @@index([batchId])
  @@index([originLocationId])
  @@index([destinationLocationId])
  @@index([userId])
  @@index([type])
  @@index([occurredAt])
  @@map("inventory_movements")
}

// ======================================================
// CAJAS / TERMINALES
// ======================================================

model CashRegister {
  id String @id @default(uuid()) @db.Uuid

  code        String  @unique @db.VarChar(50)
  name        String  @db.VarChar(120)
  description String? @db.VarChar(255)

  isActive Boolean @default(true)

  sessions CashSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@map("cash_registers")
}

// ======================================================
// SESIONES / APERTURA Y CIERRE DE CAJA
// ======================================================

model CashSession {
  id String @id @default(uuid()) @db.Uuid

  cashRegisterId String       @db.Uuid
  cashRegister   CashRegister @relation(fields: [cashRegisterId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  openedById String @db.Uuid
  openedBy   User   @relation("CashSessionOpenedBy", fields: [openedById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  closedById String? @db.Uuid
  closedBy   User?   @relation("CashSessionClosedBy", fields: [closedById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  status CashSessionStatus @default(OPEN)

  openingAmount    Decimal  @default(0) @db.Decimal(14, 2)
  expectedAmount   Decimal? @db.Decimal(14, 2)
  countedAmount    Decimal? @db.Decimal(14, 2)
  differenceAmount Decimal? @db.Decimal(14, 2)

  openedAt DateTime  @default(now())
  closedAt DateTime?

  notes String? @db.Text

  sales     Sale[]
  movements CashMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cashRegisterId])
  @@index([openedById])
  @@index([closedById])
  @@index([status])
  @@index([openedAt])
  @@map("cash_sessions")
}

// ======================================================
// VENTAS
// ======================================================

model Sale {
  id String @id @default(uuid()) @db.Uuid

  code String @unique @db.VarChar(100)

  status SaleStatus @default(DRAFT)

  sellerId String @db.Uuid
  seller   User   @relation("SaleSeller", fields: [sellerId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  cashSessionId String?      @db.Uuid
  cashSession   CashSession? @relation(fields: [cashSessionId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  customerRut  String? @db.VarChar(20)
  customerName String? @db.VarChar(200)

  customerBusinessName     String? @db.VarChar(200)
  customerBusinessActivity String? @db.VarChar(200)
  customerAddress          String? @db.VarChar(255)

  subtotal       Decimal @default(0) @db.Decimal(14, 2)
  discountAmount Decimal @default(0) @db.Decimal(14, 2)
  netAmount      Decimal @default(0) @db.Decimal(14, 2)
  taxAmount      Decimal @default(0) @db.Decimal(14, 2)
  totalAmount    Decimal @default(0) @db.Decimal(14, 2)

  saleDate DateTime @default(now())
  notes    String?  @db.Text

  items             SaleItem[]
  payments          Payment[]
  taxDocument       TaxDocument?
  cashMovements     CashMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sellerId])
  @@index([cashSessionId])
  @@index([status])
  @@index([saleDate])
  @@index([customerRut])
  @@map("sales")
}

// ======================================================
// DETALLE DE VENTA
// ======================================================

model SaleItem {
  id String @id @default(uuid()) @db.Uuid

  saleId String @db.Uuid
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  quantity Int
  prescriptionType PrescriptionType @default(NONE)
  prescriptionConfirmed Boolean @default(false)
  prescriptionRetained Boolean @default(false)

  unitPrice      Decimal @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(14, 2)
  netAmount      Decimal @default(0) @db.Decimal(14, 2)
  taxAmount      Decimal @default(0) @db.Decimal(14, 2)
  totalAmount    Decimal @db.Decimal(14, 2)

  batchAllocations SaleItemBatch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

// ======================================================
// LOTES UTILIZADOS EN CADA DETALLE DE VENTA
// ======================================================

model SaleItemBatch {
  id String @id @default(uuid()) @db.Uuid

  saleItemId String   @db.Uuid
  saleItem   SaleItem @relation(fields: [saleItemId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  batchId String @db.Uuid
  batch   Batch  @relation(fields: [batchId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  quantity Int

  createdAt DateTime @default(now())

  @@unique([saleItemId, batchId])
  @@index([saleItemId])
  @@index([batchId])
  @@map("sale_item_batches")
}

// ======================================================
// PAGOS
// ======================================================

model Payment {
  id String @id @default(uuid()) @db.Uuid

  saleId String @db.Uuid
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  method PaymentMethod
  amount Decimal       @db.Decimal(14, 2)

  referenceCode String? @db.VarChar(150)

  paidAt    DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([saleId])
  @@index([method])
  @@index([paidAt])
  @@map("payments")
}

// ======================================================
// MOVIMIENTOS DE CAJA
// ======================================================

model CashMovement {
  id String @id @default(uuid()) @db.Uuid

  cashSessionId String      @db.Uuid
  cashSession   CashSession @relation(fields: [cashSessionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  type CashMovementType

  amount      Decimal @db.Decimal(14, 2)
  description String? @db.VarChar(255)

  saleId String? @db.Uuid
  sale   Sale?   @relation(fields: [saleId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([cashSessionId])
  @@index([saleId])
  @@index([userId])
  @@index([type])
  @@index([occurredAt])
  @@map("cash_movements")
}

// ======================================================
// DOCUMENTOS TRIBUTARIOS
// ======================================================

model TaxDocument {
  id String @id @default(uuid()) @db.Uuid

  saleId String @unique @db.Uuid
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  type   TaxDocumentType
  status TaxDocumentStatus @default(PENDING)

  folio String? @db.VarChar(100)

  siiTrackId  String? @db.VarChar(150)
  siiResponse String? @db.Text

  xmlUrl String? @db.VarChar(500)
  pdfUrl String? @db.VarChar(500)

  issuedAt   DateTime?
  acceptedAt DateTime?
  rejectedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([status])
  @@index([folio])
  @@map("tax_documents")
}

// ======================================================
// AUDITORÍA
// ======================================================

model AuditLog {
  id String @id @default(uuid()) @db.Uuid

  userId String? @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  action   AuditAction
  module   String      @db.VarChar(100)
  entity   String?     @db.VarChar(100)
  entityId String?     @db.VarChar(100)

  description String? @db.Text

  oldValues Json?
  newValues Json?
  metadata  Json?

  ipAddress String? @db.VarChar(64)
  userAgent String? @db.VarChar(500)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([module])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ======================================================
// ALERTAS
// ======================================================

model Alert {
  id String @id @default(uuid()) @db.Uuid

  type   AlertType
  status AlertStatus @default(PENDING)

  title   String @db.VarChar(180)
  message String @db.Text

  productId String?  @db.Uuid
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  batchId String? @db.Uuid
  batch   Batch?  @relation(fields: [batchId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdById String? @db.Uuid
  createdBy   User?   @relation("AlertCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  resolvedById String? @db.Uuid
  resolvedBy   User?   @relation("AlertResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  dueAt      DateTime?
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([type])
  @@index([status])
  @@index([productId])
  @@index([batchId])
  @@index([dueAt])
  @@index([createdAt])
  @@map("alerts")
}

// ======================================================
// CONFIGURACIÓN GENERAL DEL SISTEMA
// ======================================================

model SystemSetting {
  id          String  @id @default(uuid()) @db.Uuid
  key         String  @unique @db.VarChar(120)
  value       String  @db.Text
  description String? @db.VarChar(255)
  isPublic    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}
